[sub_resource type="GDScript" id="GDScript_ig7tw"]
script/source = "extends Area3D

func _ready() -> void:
	body_entered.connect(_on_body_entered)

func _on_body_entered(body):
	if body.name == \"Player\":
		body.respawn()
"

[sub_resource type="SphereShape3D" id="SphereShape3D_0xm2m"]

[sub_resource type="GDScript" id="GDScript_kidjj"]
script/source = "extends Area3D

func _on_body_entered(body):
	if body.name == \"Player\":
		print(\"Collected:\", GameManager.coins_collected)
		print(\"Total:\", GameManager.total_coins)

		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)

		if GameManager.coins_collected == GameManager.total_coins:
			print(\"WIN\")
			get_tree().change_scene_to_file.call_deferred(\"res://WinScreen.tscn\")
		else:
			print(\"LOSE\")
			get_tree().change_scene_to_file.call_deferred(\"res://LoseScreen.tscn\")
"

